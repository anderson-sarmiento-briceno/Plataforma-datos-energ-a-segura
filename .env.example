# Plantilla de variables de entorno. `make setup` la copia a .env si no existe.
#
# Las credenciales de abajo son SOLO para desarrollo local:
#   - permiten clonar y correr sin configurar nada (make setup && make up);
#   - Postgres solo escucha en 127.0.0.1;
#   - no tienen relación con ningún secreto anterior del prototipo.
# En producción vendrían de un gestor de secretos (ver SECURITY.md).
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=energia_datos
PG_SUPERUSER=energia_admin
PG_SUPERPASSWORD=local_dev_energia_admin_2026

PG_ROL_INGESTA_USER=rol_ingesta
PG_ROL_INGESTA_PASSWORD=local_dev_ingesta_2026
PG_ROL_ANALISTA_USER=rol_analista
PG_ROL_ANALISTA_PASSWORD=local_dev_analista_2026
PG_ROL_AUDITOR_USER=rol_auditor
PG_ROL_AUDITOR_PASSWORD=local_dev_auditor_2026

KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=mediciones.raw

# Llaves de cifrado (AES-256-GCM) y de HMAC del NIT: NO van aquí.
# `make setup` las genera al azar en .env (LLAVE_CIFRADO, LLAVE_HMAC).
# Si se pierden, la PII ya cifrada no se puede leer: en producción vendrían de un KMS.
